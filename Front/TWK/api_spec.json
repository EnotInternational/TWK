          "404": {
            "description": "\u0410\u0433\u0435\u043d\u0442 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d"
          }
        },
        "summary": "\u041e\u0431\u043d\u043e\u0432\u0438\u0442\u044c \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u0430\u0433\u0435\u043d\u0442\u0430 (\u0433\u043e\u043b\u043e\u0434, \u043a\u043e\u043e\u0440\u0434\u0438\u043d\u0430\u0442\u044b).",
